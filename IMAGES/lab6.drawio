        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam classAttributeIconSize 0\n\nclass PhongBan {\n    + MaPB : String &lt;&lt;PK&gt;&gt;\n    + TenPB : String\n    + LoaiDonVi : String\n    --\n    + themPhongBan() : bool\n    + suaPhongBan() : bool\n    + xoaPhongBan() : bool\n}\n\nclass ChucVu {\n    + MaCV : String &lt;&lt;PK&gt;&gt;\n    + TenCV : String\n    --\n    + themChucVu() : bool\n    + suaChucVu() : bool\n    + xoaChucVu() : bool\n}\n\nclass NhanVien {\n    + MaNV : String &lt;&lt;PK&gt;&gt;\n    + FK MaPB : String\n    + HoTen : String\n    + NgaySinh : DateTime\n    + GioiTinh : String\n    + DienThoai : String\n    + DiaChi : String\n    + TrangThai : String\n    --\n    + themNhanVien() : bool\n    + suaNhanVien() : bool\n    + chuyenChinhThuc() : bool\n}\n\nclass QuyetDinhTuyenDung {\n    + SoQD : String &lt;&lt;PK&gt;&gt;\n    + FK MaNV : String\n    + FK MaPB : String\n    + NgayQD : DateTime\n    + NgayBatDauThuViec : DateTime\n    + NgayKetThucThuViec : DateTime\n    + LuongThuViec : Decimal\n    + DieuKhoan : String\n    --\n    + lapQuyetDinh() : bool\n    + tinhThoiGianThuViec() : int\n}\n\nclass HopDong {\n    + SoHD : String &lt;&lt;PK&gt;&gt;\n    + FK MaNV : String\n    + LoaiHD : String\n    + NgayKy : DateTime\n    + NgayBatDau : DateTime\n    + NgayKetThuc : DateTime\n    --\n    + kyHopDong() : bool\n    + giaHanHopDong() : bool\n}\n\nclass QuyetDinhLuong {\n    + SoQD : String &lt;&lt;PK&gt;&gt;\n    + FK MaNV : String\n    + NgayHieuLuc : DateTime\n    + LuongCoBan : Decimal\n    + PhuCapLuong : Decimal\n    + PhuCapDocHai : Decimal\n    + LyDo : String\n    --\n    + lapQuyetDinhLuong() : bool\n    + layLuongHieuLucMoiNhat() : QuyetDinhLuong\n}\n\nclass QuyetDinhChucVu {\n    + SoQD : String &lt;&lt;PK&gt;&gt;\n    + FK MaNV : String\n    + FK MaCV : String\n    + NgayHieuLuc : DateTime\n    + PhuCapChucVu : Decimal\n    --\n    + boNhiem() : bool\n}\n\nclass HoSoBaoHiem {\n    + MaHS : String &lt;&lt;PK&gt;&gt;\n    + FK MaNV : String\n    + SoBHXH : String\n    + SoBHYT : String\n    + TyLeBHXH : float\n    + TyLeBHYT : float\n    + NgayLap : DateTime\n    --\n    + lapHoSo() : bool\n    + tinhKhoanTruBaoHiem() : Decimal\n}\n\nclass BangChamCong {\n    + PK FK MaNV : String\n    + PK Thang : int\n    + PK Nam : int\n    + NgayCongChuan : int\n    + SoNgayCong : float\n    --\n    + nhapChamCong() : bool\n    + layChamCongThang() : DataTable\n}\n\nclass KeHoachTuan {\n    + MaKH : String &lt;&lt;PK&gt;&gt;\n    + FK MaPB : String\n    + TuNgay : DateTime\n    + DenNgay : DateTime\n    + NoiDungPhanCong : String\n    + GioPhuTroiDuKien : float\n    --\n    + lapKeHoach() : bool\n}\n\nclass PhieuPhuTroi {\n    + SoPhieu : String &lt;&lt;PK&gt;&gt;\n    + NgayPhuTroi : DateTime\n    + SoGio : float\n    + HinhThuc : String\n    --\n    + lapPhieu() : bool\n    + tinhGioQuyDoi() : float\n}\n\nclass ChiTietPhuTroi {\n    + PK FK SoPhieu : String\n    + PK FK MaNV : String\n    --\n    + themNhanVienPhuTroi() : bool\n}\n\nclass QuyetDinhKhenThuong {\n    + SoQD : String &lt;&lt;PK&gt;&gt;\n    + FK MaNV : String\n    + FK MaPB : String\n    + NgayQD : DateTime\n    + LoaiDoiTuong : String\n    + LoaiKhenThuong : String\n    + SoTien : Decimal\n    + NguoiKy : String\n    --\n    + lapQuyetDinh() : bool\n}\n\nclass PhieuChiThuong {\n    + SoPhieuChi : String &lt;&lt;PK&gt;&gt;\n    + FK SoQD : String\n    + NgayLap : DateTime\n    + SoTien : Decimal\n    + HinhThuc : String\n    --\n    + lapPhieuChi() : bool\n}\n\nclass QuyetDinhKyLuat {\n    + SoQD : String &lt;&lt;PK&gt;&gt;\n    + FK MaNV : String\n    + FK MaPB : String\n    + NgayQD : DateTime\n    + LoaiDoiTuong : String\n    + HinhThucKyLuat : String\n    + SoTienPhat : Decimal\n    + NguoiKy : String\n    --\n    + lapQuyetDinh() : bool\n}\n\nclass PhieuThuPhat {\n    + SoPhieuThu : String &lt;&lt;PK&gt;&gt;\n    + FK SoQD : String\n    + NgayLap : DateTime\n    + SoTien : Decimal\n    + HinhThuc : String\n    --\n    + lapPhieuThu() : bool\n}\n\nclass BangLuong {\n    + PK FK MaNV : String\n    + PK Thang : int\n    + PK Nam : int\n    + LuongCoBan : Decimal\n    + PhuCap : Decimal\n    + LuongNgayCong : Decimal\n    + TienPhuTroi : Decimal\n    + Thuong : Decimal\n    + KhoanTruBH : Decimal\n    + Phat : Decimal\n    + ThucLinh : Decimal\n    --\n    + tinhLuongThang() : Decimal\n    + luuBangLuong() : bool\n}\n\n&#39; Association Lines\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachTuan\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat\n\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDong\nNhanVien \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBaoHiem\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BangChamCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BangLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhuTroi\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat\n\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhuTroi\n\nQuyetDinhKhenThuong \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuChiThuong\nQuyetDinhKyLuat \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuThuPhat\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9pAre_KsYljfEZnrnfQy-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
