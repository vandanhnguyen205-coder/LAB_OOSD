        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam classAttributeIconSize 0\nskinparam monochrome false\n\nentity PHONGBAN {\n    PK MaPB : varchar(20)\n    --\n    TenPB : nvarchar(100)\n    LoaiDonVi : nvarchar(50)\n}\n\nentity CHUCVU {\n    PK MaCV : varchar(20)\n    --\n    TenCV : nvarchar(100)\n}\n\nentity NHANVIEN {\n    PK MaNV : varchar(20)\n    --\n    FK MaPB : varchar(20)\n    HoTen : nvarchar(100)\n    NgaySinh : date\n    GioiTinh : nvarchar(10)\n    DienThoai : varchar(15)\n    DiaChi : nvarchar(200)\n    TrangThai : nvarchar(50)\n}\n\nentity QUYETDINHTUYENDUNG {\n    PK SoQD : varchar(20)\n    --\n    FK MaNV : varchar(20)\n    FK MaPB : varchar(20)\n    NgayQD : date\n    NgayBatDauThuViec : date\n    NgayKetThucThuViec : date\n    LuongThuViec : decimal(18,2)\n    DieuKhoan : nvarchar(max)\n}\n\nentity HOPDONG {\n    PK SoHD : varchar(20)\n    --\n    FK MaNV : varchar(20)\n    LoaiHD : nvarchar(50)\n    NgayKy : date\n    NgayBatDau : date\n    NgayKetThuc : date\n}\n\nentity QUYETDINHLUONG {\n    PK SoQD : varchar(20)\n    --\n    FK MaNV : varchar(20)\n    NgayHieuLuc : date\n    LuongCoBan : decimal(18,2)\n    PhuCapLuong : decimal(18,2)\n    PhuCapDocHai : decimal(18,2)\n    LyDo : nvarchar(250)\n}\n\nentity QUYETDINHCHUCVU {\n    PK SoQD : varchar(20)\n    --\n    FK MaNV : varchar(20)\n    FK MaCV : varchar(20)\n    NgayHieuLuc : date\n    PhuCapChucVu : decimal(18,2)\n}\n\nentity HOSOBAOHIEM {\n    PK MaHS : varchar(20)\n    --\n    FK MaNV : varchar(20)\n    SoBHXH : varchar(50)\n    SoBHYT : varchar(50)\n    TyLeBHXH : float\n    TyLeBHYT : float\n    NgayLap : date\n}\n\nentity BANGCHAMCONG {\n    PK FK MaNV : varchar(20)\n    PK Thang : int\n    PK Nam : int\n    --\n    NgayCongChuan : int\n    SoNgayCong : float\n}\n\nentity KEHOACHTUAN {\n    PK MaKH : varchar(20)\n    --\n    FK MaPB : varchar(20)\n    TuNgay : date\n    DenNgay : date\n    NoiDungPhanCong : nvarchar(max)\n    GioPhuTroiDuKien : float\n}\n\nentity PHIEUPHUTROI {\n    PK SoPhieu : varchar(20)\n    --\n    NgayPhuTroi : date\n    SoGio : float\n    HinhThuc : nvarchar(50)\n}\n\nentity CHITIETPHUTROI {\n    PK FK SoPhieu : varchar(20)\n    PK FK MaNV : varchar(20)\n}\n\nentity QUYETDINHKHENTHUONG {\n    PK SoQD : varchar(20)\n    --\n    FK MaNV : varchar(20)\n    FK MaPB : varchar(20)\n    NgayQD : date\n    LoaiDoiTuong : nvarchar(50)\n    LoaiKhenThuong : nvarchar(100)\n    SoTien : decimal(18,2)\n    NguoiKy : nvarchar(100)\n}\n\nentity PHIEUCHITHUONG {\n    PK SoPhieuChi : varchar(20)\n    --\n    FK SoQD : varchar(20)\n    NgayLap : date\n    SoTien : decimal(18,2)\n    HinhThuc : nvarchar(50)\n}\n\nentity QUYETDINHKYLUAT {\n    PK SoQD : varchar(20)\n    --\n    FK MaNV : varchar(20)\n    FK MaPB : varchar(20)\n    NgayQD : date\n    LoaiDoiTuong : nvarchar(50)\n    HinhThucKyLuat : nvarchar(100)\n    SoTienPhat : decimal(18,2)\n    NguoiKy : nvarchar(100)\n}\n\nentity PHIEUTHUPHAT {\n    PK SoPhieuThu : varchar(20)\n    --\n    FK SoQD : varchar(20)\n    NgayLap : date\n    SoTien : decimal(18,2)\n    HinhThuc : nvarchar(50)\n}\n\nentity BANGLUONG {\n    PK FK MaNV : varchar(20)\n    PK Thang : int\n    PK Nam : int\n    --\n    LuongCoBan : decimal(18,2)\n    PhuCap : decimal(18,2)\n    LuongNgayCong : decimal(18,2)\n    TienPhuTroi : decimal(18,2)\n    Thuong : decimal(18,2)\n    KhoanTruBH : decimal(18,2)\n    Phat : decimal(18,2)\n    ThucLinh : decimal(18,2)\n}\n\n&#39; Relationships\nPHONGBAN ||--o{ NHANVIEN\nPHONGBAN ||--o{ KEHOACHTUAN\nPHONGBAN ||--o{ QUYETDINHTUYENDUNG\nPHONGBAN ||--o{ QUYETDINHKHENTHUONG\nPHONGBAN ||--o{ QUYETDINHKYLUAT\n\nCHUCVU ||--o{ QUYETDINHCHUCVU\n\nNHANVIEN ||--o{ QUYETDINHTUYENDUNG\nNHANVIEN ||--o{ HOPDONG\nNHANVIEN ||--o| HOSOBAOHIEM\nNHANVIEN ||--o{ QUYETDINHLUONG\nNHANVIEN ||--o{ QUYETDINHCHUCVU\nNHANVIEN ||--o{ BANGCHAMCONG\nNHANVIEN ||--o{ BANGLUONG\nNHANVIEN ||--o{ CHITIETPHUTROI\nNHANVIEN ||--o{ QUYETDINHKHENTHUONG\nNHANVIEN ||--o{ QUYETDINHKYLUAT\n\nPHIEUPHUTROI ||--|{ CHITIETPHUTROI\n\nQUYETDINHKHENTHUONG ||--o| PHIEUCHITHUONG\nQUYETDINHKYLUAT ||--o| PHIEUTHUPHAT\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="mQ2djLRk3WBBzhX-jmEL-0">
