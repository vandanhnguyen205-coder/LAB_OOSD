  <diagram name="bieu do tuan tu" id="3h8YFpEB69utHqmXESNo">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="qMaDt95NDYya6N1LKe6s-0" />
        <mxCell id="qMaDt95NDYya6N1LKe6s-1" parent="qMaDt95NDYya6N1LKe6s-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nactor \&quot;NV Kinh Doanh\&quot; as NV\nparticipant \&quot;FrmHopDongThue\\n(UI)\&quot; as UI\nparticipant \&quot;HopDongService\\n(Service)\&quot; as Service\ndatabase \&quot;SQL Server\\n(CSDL)\&quot; as DB\n\nNV -&gt; UI: 1. Mở Form Lập hợp đồng\nactivate UI\nUI -&gt; Service: GetDanhSachPhongTrong()\nactivate Service\nService -&gt; DB: SELECT * FROM Phong WHERE TrangThai = &#39;Trống&#39;\nactivate DB\nDB --&gt; Service: Danh sách phòng trống\ndeactivate DB\nService --&gt; UI: Hiển thị lên DataGridView/ComboBox\ndeactivate Service\n\nNV -&gt; UI: 2. Nhập thông tin Khách hàng, chọn Phòng,\\nnhập Ngày BD &amp; Thời gian thuê (tháng)\nNV -&gt; UI: 3. Nhấn \&quot;Lưu &amp; In hợp đồng\&quot;\n\nalt Thời gian thuê &lt; 6 tháng\n    UI --&gt; NV: Hiển thị thông báo lỗi\\n(\&quot;Thời gian thuê tối thiểu 6 tháng\&quot;)\nelse Thời gian thuê &gt;= 6 tháng\n    UI -&gt; Service: LapHopDong(hopDongDTO)\n    activate Service\n    \n    Service -&gt; DB: Begin Transaction\n    activate DB\n    \n    Service -&gt; DB: KiemTraPhongTrong(MaPhong)\n    DB --&gt; Service: Kết quả kiểm tra\n    \n    alt Phòng đã bị đặt bởi giao dịch khác\n        Service -&gt; DB: Rollback Transaction\n        Service --&gt; UI: Báo lỗi (\&quot;Phòng đã bị trùng lịch\&quot;)\n        UI --&gt; NV: Thông báo thất bại\n    else Phòng hợp lệ\n        Service -&gt; DB: INSERT INTO KhachHang (nếu mới)\n        Service -&gt; DB: INSERT INTO HopDongThue (SoHD, MaKhach, ThoiGianThue...)\n        Service -&gt; DB: INSERT INTO ChiTietHopDong (SoHD, MaPhong...)\n        Service -&gt; DB: UPDATE Phong SET TrangThai = &#39;Đang thuê&#39;\n        Service -&gt; DB: INSERT INTO HoaDon (Tiền phòng 6 tháng đầu)\n        \n        Service -&gt; DB: Commit Transaction\n        DB --&gt; Service: Thành công\n        deactivate DB\n        \n        Service --&gt; UI: Kết quả thành công (SoHD)\n        deactivate Service\n        UI --&gt; NV: Thông báo thành công &amp; In Hợp đồng\n    end\nend\ndeactivate UI\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="R6H_GyAwm9eaKMP45Hgi-0">
