  <diagram name="bieu do tuan tu" id="MRTbmS_6TOPBA1WMawy-">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="om1JuGNAda0Cg58WCE50-0" />
        <mxCell id="om1JuGNAda0Cg58WCE50-1" parent="om1JuGNAda0Cg58WCE50-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nactor \&quot;NV Kinh Doanh\&quot; as NV\nparticipant \&quot;FrmGiaHan\\n(UI)\&quot; as UI\nparticipant \&quot;GiaHanService\\n(Service)\&quot; as Service\ndatabase \&quot;SQL Server\\n(CSDL)\&quot; as DB\n\nNV -&gt; UI: 1. Mở Form Gia hạn &amp; nhập Số HĐ/Mã phòng\nactivate UI\nUI -&gt; Service: GetThongTinHopDong(soHD)\nactivate Service\nService -&gt; DB: SELECT * FROM HopDongThue WHERE SoHD = @SoHD\nactivate DB\nDB --&gt; Service: Thông tin HĐ (ThoiGianThueGoc, NgayHetHan...)\ndeactivate DB\nService --&gt; UI: Hiển thị thông tin HĐ gốc lên Form\ndeactivate Service\n\nNV -&gt; UI: 2. Nhập Thời gian gia hạn đăng ký (số tháng)\nNV -&gt; UI: 3. Nhấn \&quot;Lưu phiếu gia hạn\&quot;\n\nUI -&gt; UI: Kiểm tra điều kiện:\\n(Thời gian gia hạn &gt; 0.5 * Thời gian gốc)\n\nalt Thời gian gia hạn &lt;= 0.5 * Thời gian gốc\n    UI --&gt; NV: Hiển thị thông báo lỗi\\n(\&quot;TG gia hạn phải &gt; 1/2 TG thuê gốc\&quot;)\nelse Thời gian gia hạn hợp lệ (&gt; 0.5 * TG gốc)\n    UI -&gt; Service: LapPhieuGiaHan(phieuGiaHanDTO)\n    activate Service\n    \n    Service -&gt; DB: Begin Transaction\n    activate DB\n    \n    Service -&gt; DB: INSERT INTO PhieuGiaHan (SoPhieu, SoHD, MaPhong, ThoiGianGH...)\n    Service -&gt; DB: UPDATE HopDongThue SET NgayHetHanMoi = ...\n    \n    Service -&gt; DB: Commit Transaction\n    DB --&gt; Service: Thành công\n    deactivate DB\n    \n    Service --&gt; UI: Trả về kết quả thành công\n    deactivate Service\n    \n    UI --&gt; NV: Thông báo gia hạn thành công &amp; In Phiếu gia hạn\nend\ndeactivate UI\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="svtSt2TNOYfD0D5esyWa-0">
          <mxCell connectable="0" parent="om1JuGNAda0Cg58WCE50-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
