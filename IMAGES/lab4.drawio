        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam activity {\n  BackgroundColor White\n  BorderColor Black\n}\n\n|Khách hàng|\nstart\n:Chọn tính tiền;\n\n|Hệ thống|\nif (Giỏ rỗng?) then (có)\n  :Thông báo giỏ rỗng;\n  stop\nendif\n:Kiểm tra tình trạng còn hàng;\nif (Có sản phẩm hết hàng?) then (có)\n  :Thông báo sản phẩm hết hàng;\n  stop\nendif\n\nif (Đã đăng nhập?) then (chưa)\n  |Khách hàng|\n  if (Đã có tài khoản?) then (có)\n    :Đăng nhập;\n  else (chưa)\n    :Đăng ký tài khoản;\n  endif\nendif\n\n|Khách hàng|\n:Chọn loại phiếu đặt hàng;\n:Nhập thông tin người nhận;\n\n|Hệ thống|\n:Xác định khu vực giao hàng;\n:Tính phí giao hàng\n(miễn phí nếu đạt ngưỡng);\n\nrepeat\n  |Khách hàng|\n  :Nhập thông tin thẻ tín dụng;\n  |Hệ thống|\n  :Kiểm tra định dạng thẻ;\n  if (Đúng định dạng?) then (đúng)\n    :Tính lệ phí thẻ và tổng trị giá;\n    |DV Thanh toán|\n    :Xác thực thẻ và khả năng thanh toán;\n    |Hệ thống|\n  else (sai)\n    :Báo lỗi định dạng thẻ;\n  endif\nrepeat while (Thẻ chưa hợp lệ\\nvà khách muốn nhập lại?) is (có) not (không)\n\nif (Thẻ hợp lệ?) then (không)\n  :Thông báo thanh toán thất bại;\n  stop\nendif\n\n:Ghi nhận đơn đặt hàng và chi tiết đơn;\n:Làm trống giỏ hàng;\n:Thông báo đặt hàng thành công;\n\nif (Khách có email?) then (có)\n  :Soạn nội dung email\n(không có thông tin thẻ);\n  |DV Email|\n  :Gửi email xác nhận;\n  |Hệ thống|\n  :Ghi log kết quả gửi;\nendif\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yAaaz0Ec4-OwOu2ILd82-83">
