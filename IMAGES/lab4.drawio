        <mxCell id="VtNFslm_fU1FZqV-8Fad-1" parent="VtNFslm_fU1FZqV-8Fad-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam classAttributeIconSize 0\nskinparam class {\n  BackgroundColor White\n  BorderColor Black\n}\nhide circle\nhide empty members\n\nenum TrangThaiDon {\n  KhoiTao\n  ChoThanhToan\n  DaXacNhan\n  ThanhToanThatBai\n  DaHuy\n}\n\nclass KhachHang {\n  -maKH : int\n  -hoTen : string\n  -ngaySinh : DateTime\n  -soCMND_Passport : string\n  -diaChi : string\n  -dienThoai : string\n  -tenDangNhap : string\n  -matKhau : string\n  -email : string\n  +KiemTraHopLe() : bool\n  +KiemTraMatKhau(matKhau : string) : bool\n  +CoEmail() : bool\n}\n\nclass NhomSanPham {\n  -maNhom : string\n  -tenNhom : string\n}\n\nclass SanPham {\n  -maSP : string\n  -tenSP : string\n  -nhaSanXuat : string\n  -hinhAnh : string\n  -moTa : string\n  -thongSoKyThuat : string\n  -giaBan : decimal\n  -tinhTrang : bool\n  +ConHang() : bool\n}\n\nclass GioHang {\n  -maGioHang : int\n  -tamTinh : decimal\n  +ThemMuc(sp : SanPham, soLuong : int) : void\n  +CapNhatSoLuong(maSP : string, soLuong : int) : void\n  +XoaMuc(maSP : string) : void\n  +TinhTamTinh() : decimal\n  +LamTrong() : void\n  +LaRong() : bool\n}\n\nclass MucGioHang {\n  -soLuong : int\n  -thanhTien : decimal\n  +CongDonSoLuong(soLuong : int) : void\n  +TinhThanhTien() : decimal\n}\n\nclass DonDatHang {\n  -maDon : int\n  -thoiDiemDat : DateTime\n  -phiGiao : decimal\n  -lePhiThe : decimal\n  -tongTriGia : decimal\n  -trangThai : TrangThaiDon\n  +TinhTienHang() : decimal\n  +TinhPhiGiao() : decimal\n  +TinhLePhiThe() : decimal\n  +TinhTongTriGia() : decimal\n  +DoiTrangThai(trangThai : TrangThaiDon) : void\n}\n\nclass ChiTietDonHang {\n  -soLuong : int\n  -donGia : decimal\n  +TinhThanhTien() : decimal\n}\n\nclass NguoiNhan {\n  -maNguoiNhan : int\n  -hoTen : string\n  -diaChi : string\n  -dienThoai : string\n}\n\nclass TheTinDung {\n  -maThe : int\n  -soHieuThe : string\n  -ngayHetHan : DateTime\n  -tenChuThe : string\n  -csv : string\n  +KiemTraDinhDang() : bool\n  +ConHieuLuc() : bool\n}\n\nclass LoaiThe {\n  -maLoaiThe : int\n  -tenLoai : string\n  -doDaiSoThe : int\n  -doDaiCSV : int\n  -lePhi : decimal\n  +LayLePhi(tienHang : decimal) : decimal\n}\n\nclass LoaiPhieu {\n  -maLoaiPhieu : int\n  -tenLoai : string\n  -donGia : decimal\n  -thoiGianXuLy : string\n  -nguongMienPhi : decimal\n  +TinhPhiGiao(phiKhuVuc : decimal) : decimal\n  +DuocMienPhi(tienHang : decimal) : bool\n}\n\nclass KhuVucGiao {\n  -maKV : int\n  -tenKV : string\n  -phiGiao : decimal\n  +LayPhiGiao() : decimal\n}\n\n&#39; --- Quan hệ kết hợp (thay cho khóa ngoại) ---\nNhomSanPham \&quot;1\&quot; -- \&quot;0..*\&quot; SanPham : gồm\nKhachHang \&quot;1\&quot; -- \&quot;0..1\&quot; GioHang : có giỏ hiện tại\nMucGioHang \&quot;0..*\&quot; -- \&quot;1\&quot; SanPham : chứa\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; DonDatHang : đặt\nDonDatHang \&quot;0..*\&quot; -- \&quot;1\&quot; LoaiPhieu : theo loại\nDonDatHang \&quot;0..*\&quot; -- \&quot;1\&quot; KhuVucGiao : giao đến\nDonDatHang \&quot;1\&quot; -- \&quot;1\&quot; NguoiNhan : giao cho\nDonDatHang \&quot;0..*\&quot; -- \&quot;1\&quot; TheTinDung : thanh toán bằng\nTheTinDung \&quot;0..*\&quot; -- \&quot;1\&quot; LoaiThe : thuộc loại\nChiTietDonHang \&quot;0..*\&quot; -- \&quot;1\&quot; SanPham : tham chiếu\n\n&#39; --- Quan hệ hợp thành (đầu phiếu - chi tiết phiếu) ---\nGioHang \&quot;1\&quot; *-- \&quot;0..*\&quot; MucGioHang : gồm\nDonDatHang \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietDonHang : gồm\n\nDonDatHang ..&gt; TrangThaiDon\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VtNFslm_fU1FZqV-8Fad-2">
