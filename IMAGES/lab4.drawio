    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="KfLC2mAQeMI-K3-2F7ab-0" />
        <mxCell id="KfLC2mAQeMI-K3-2F7ab-1" parent="KfLC2mAQeMI-K3-2F7ab-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam shadowing false\nskinparam linetype ortho\nskinparam entity {\n  BackgroundColor White\n  BorderColor Black\n}\n\nentity \&quot;KHACHHANG\&quot; as KHACHHANG {\n  * MaKH : int &lt;&lt;PK&gt;&gt;\n  --\n  * HoTen : nvarchar(100)\n  * NgaySinh : date\n  * SoCMND_Passport : nvarchar(20)\n  * DiaChi : nvarchar(200)\n  * DienThoai : nvarchar(15)\n  * TenDangNhap : nvarchar(50) &lt;&lt;UK&gt;&gt;\n  * MatKhau : nvarchar(255)\n  Email : nvarchar(100)\n}\n\nentity \&quot;NHOMSANPHAM\&quot; as NHOMSANPHAM {\n  * MaNhom : nvarchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * TenNhom : nvarchar(100)\n}\n\nentity \&quot;SANPHAM\&quot; as SANPHAM {\n  * MaSP : nvarchar(20) &lt;&lt;PK&gt;&gt;\n  --\n  * MaNhom : nvarchar(20) &lt;&lt;FK&gt;&gt;\n  * TenSP : nvarchar(200)\n  NhaSanXuat : nvarchar(100)\n  HinhAnh : nvarchar(255)\n  MoTa : nvarchar(max)\n  ThongSoKyThuat : nvarchar(max)\n  * GiaBan : decimal(18,0)\n  * TinhTrang : bit\n}\n\nentity \&quot;GIOHANG\&quot; as GIOHANG {\n  * MaGioHang : int &lt;&lt;PK&gt;&gt;\n  --\n  * MaKH : int &lt;&lt;FK&gt;&gt; &lt;&lt;UK&gt;&gt;\n  * TamTinh : decimal(18,0)\n}\n\nentity \&quot;MUCGIOHANG\&quot; as MUCGIOHANG {\n  * MaGioHang : int &lt;&lt;PK&gt;&gt; &lt;&lt;FK&gt;&gt;\n  * MaSP : nvarchar(20) &lt;&lt;PK&gt;&gt; &lt;&lt;FK&gt;&gt;\n  --\n  * SoLuong : int\n  * ThanhTien : decimal(18,0)\n}\n\nentity \&quot;LOAIPHIEU\&quot; as LOAIPHIEU {\n  * MaLoaiPhieu : int &lt;&lt;PK&gt;&gt;\n  --\n  * TenLoai : nvarchar(50)\n  * DonGia : decimal(18,0)\n  * ThoiGianXuLy : nvarchar(50)\n  NguongMienPhi : decimal(18,0)\n}\n\nentity \&quot;KHUVUCGIAO\&quot; as KHUVUCGIAO {\n  * MaKV : int &lt;&lt;PK&gt;&gt;\n  --\n  * TenKV : nvarchar(100)\n  * PhiGiao : decimal(18,0)\n}\n\nentity \&quot;LOAITHE\&quot; as LOAITHE {\n  * MaLoaiThe : int &lt;&lt;PK&gt;&gt;\n  --\n  * TenLoai : nvarchar(50)\n  * DoDaiSoThe : int\n  * DoDaiCSV : int\n  * LePhi : decimal(18,0)\n}\n\nentity \&quot;THETINDUNG\&quot; as THETINDUNG {\n  * MaThe : int &lt;&lt;PK&gt;&gt;\n  --\n  * MaLoaiThe : int &lt;&lt;FK&gt;&gt;\n  * SoCuoi4 : char(4)\n  * NgayHetHan : date\n  * TenChuThe : nvarchar(100)\n}\n\nentity \&quot;NGUOINHAN\&quot; as NGUOINHAN {\n  * MaNguoiNhan : int &lt;&lt;PK&gt;&gt;\n  --\n  * HoTen : nvarchar(100)\n  * DiaChi : nvarchar(200)\n  * DienThoai : nvarchar(15)\n}\n\nentity \&quot;DONDATHANG\&quot; as DONDATHANG {\n  * MaDon : int &lt;&lt;PK&gt;&gt;\n  --\n  * MaKH : int &lt;&lt;FK&gt;&gt;\n  * MaLoaiPhieu : int &lt;&lt;FK&gt;&gt;\n  * MaKV : int &lt;&lt;FK&gt;&gt;\n  * MaThe : int &lt;&lt;FK&gt;&gt;\n  * MaNguoiNhan : int &lt;&lt;FK&gt;&gt; &lt;&lt;UK&gt;&gt;\n  * ThoiDiemDat : datetime\n  * PhiGiao : decimal(18,0)\n  * LePhiThe : decimal(18,0)\n  * TongTriGia : decimal(18,0)\n  * TrangThai : nvarchar(30)\n}\n\nentity \&quot;CHITIETDONHANG\&quot; as CHITIETDONHANG {\n  * MaDon : int &lt;&lt;PK&gt;&gt; &lt;&lt;FK&gt;&gt;\n  * MaSP : nvarchar(20) &lt;&lt;PK&gt;&gt; &lt;&lt;FK&gt;&gt;\n  --\n  * SoLuong : int\n  * DonGia : decimal(18,0)\n}\n\nNHOMSANPHAM  ||--o{ SANPHAM\nKHACHHANG    ||--o| GIOHANG\nGIOHANG      ||--o{ MUCGIOHANG\nSANPHAM      ||--o{ MUCGIOHANG\nKHACHHANG    ||--o{ DONDATHANG\nLOAIPHIEU    ||--o{ DONDATHANG\nKHUVUCGIAO   ||--o{ DONDATHANG\nNGUOINHAN    ||--|| DONDATHANG\nTHETINDUNG   ||--o{ DONDATHANG\nLOAITHE      ||--o{ THETINDUNG\nDONDATHANG   ||--|{ CHITIETDONHANG\nSANPHAM      ||--o{ CHITIETDONHANG\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Hi9AP5OAZigcWB5Sh0T8-0">
