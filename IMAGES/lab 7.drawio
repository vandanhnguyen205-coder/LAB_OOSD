        <mxCell id="ynYtLSSX9TxJPfR4FnTc-1" parent="ynYtLSSX9TxJPfR4FnTc-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam style strictuml\nskinparam packageStyle rectangle\n\n\n\n    class PhongBan {\n        + MaPB : String &lt;&lt;PK&gt;&gt;\n        --\n        TenPB : String\n        LoaiDonVi : String\n    }\n\n    class ChucVu {\n        + MaCV : String &lt;&lt;PK&gt;&gt;\n        --\n        TenCV : String\n    }\n\n    class NhanVien {\n        + MaNV : String &lt;&lt;PK&gt;&gt;\n        --\n        HoTen : String\n        NgaySinh : Date\n        GioiTinh : String\n        DienThoai : String\n        DiaChi : String\n        TrangThai : String\n        MaPB : String &lt;&lt;FK&gt;&gt;\n    }\n\n    class QuyetDinhTuyenDung {\n        + SoQD : String &lt;&lt;PK&gt;&gt;\n        --\n        NgayQD : Date\n        NgayBatDauThuViec : Date\n        NgayKetThucThuViec : Date\n        LuongThuViec : Decimal\n        DieuKhoan : String\n        MaNV : String &lt;&lt;FK&gt;&gt;\n        MaPB : String &lt;&lt;FK&gt;&gt;\n    }\n\n    class HopDong {\n        + SoHD : String &lt;&lt;PK&gt;&gt;\n        --\n        LoaiHD : String\n        NgayKy : Date\n        NgayBatDau : Date\n        NgayKetThuc : Date\n        MaNV : String &lt;&lt;FK&gt;&gt;\n    }\n\n    class QuyetDinhLuong {\n        + SoQD : String &lt;&lt;PK&gt;&gt;\n        --\n        NgayHieuLuc : Date\n        LuongCoBan : Decimal\n        PhuCapLuong : Decimal\n        PhuCapDocHai : Decimal\n        LyDo : String\n        MaNV : String &lt;&lt;FK&gt;&gt;\n    }\n\n    class QuyetDinhChucVu {\n        + SoQD : String &lt;&lt;PK&gt;&gt;\n        --\n        NgayHieuLuc : Date\n        PhuCapChucVu : Decimal\n        MaNV : String &lt;&lt;FK&gt;&gt;\n        MaCV : String &lt;&lt;FK&gt;&gt;\n    }\n\n    class HoSoBaoHiem {\n        + MaHS : String &lt;&lt;PK&gt;&gt;\n        --\n        SoBHXH : String\n        SoBHYT : String\n        TyLeBHXH : float\n        TyLeBHYT : float\n        NgayLap : Date\n        MaNV : String &lt;&lt;FK&gt;&gt;\n    }\n\n    class BangChamCong {\n        + MaNV : String &lt;&lt;PK, FK&gt;&gt;\n        + Thang : int &lt;&lt;PK&gt;&gt;\n        + Nam : int &lt;&lt;PK&gt;&gt;\n        --\n        NgayCongChuan : int\n        SoNgayCong : float\n    }\n\n    class KeHoachTuan {\n        + MaKH : String &lt;&lt;PK&gt;&gt;\n        --\n        TuNgay : Date\n        DenNgay : Date\n        NoiDungPhanCong : String\n        GioPhuTroiDuKien : float\n        MaPB : String &lt;&lt;FK&gt;&gt;\n    }\n\n    class PhieuPhuTroi {\n        + SoPhieu : String &lt;&lt;PK&gt;&gt;\n        --\n        NgayPhuTroi : Date\n        SoGio : float\n        HinhThuc : String\n    }\n\n    class ChiTietPhuTroi {\n        + SoPhieu : String &lt;&lt;PK, FK&gt;&gt;\n        + MaNV : String &lt;&lt;PK, FK&gt;&gt;\n    }\n\n    class QuyetDinhKhenThuong {\n        + SoQD : String &lt;&lt;PK&gt;&gt;\n        --\n        NgayQD : Date\n        LoaiDoiTuong : String\n        LoaiKhenThuong : String\n        SoTien : Decimal\n        NguoiKy : String\n        MaNV : String &lt;&lt;FK, Nullable&gt;&gt;\n        MaPB : String &lt;&lt;FK, Nullable&gt;&gt;\n    }\n\n    class PhieuChiThuong {\n        + SoPhieuChi : String &lt;&lt;PK&gt;&gt;\n        --\n        NgayLap : Date\n        SoTien : Decimal\n        HinhThuc : String\n        SoQD : String &lt;&lt;FK&gt;&gt;\n    }\n\n    class QuyetDinhKyLuat {\n        + SoQD : String &lt;&lt;PK&gt;&gt;\n        --\n        NgayQD : Date\n        LoaiDoiTuong : String\n        HinhThucKyLuat : String\n        SoTienPhat : Decimal\n        NguoiKy : String\n        MaNV : String &lt;&lt;FK, Nullable&gt;&gt;\n        MaPB : String &lt;&lt;FK, Nullable&gt;&gt;\n    }\n\n    class PhieuThuPhat {\n        + SoPhieuThu : String &lt;&lt;PK&gt;&gt;\n        --\n        NgayLap : Date\n        SoTien : Decimal\n        HinhThuc : String\n        SoQD : String &lt;&lt;FK&gt;&gt;\n    }\n\n    class BangLuong {\n        + MaNV : String &lt;&lt;PK, FK&gt;&gt;\n        + Thang : int &lt;&lt;PK&gt;&gt;\n        + Nam : int &lt;&lt;PK&gt;&gt;\n        --\n        LuongCoBan : Decimal\n        PhuCap : Decimal\n        LuongNgayCong : Decimal\n        TienPhuTroi : Decimal\n        Thuong : Decimal\n        KhoanTruBH : Decimal\n        Phat : Decimal\n        ThucLinh : Decimal\n    }\n\n\n&#39; Mối quan hệ liên kết cơ sở dữ liệu (Database Relationships)\nPhongBan \&quot;1\&quot; ||--o{ NhanVien : \&quot;thuộc\&quot;\nPhongBan \&quot;1\&quot; ||--o{ KeHoachTuan : \&quot;lập\&quot;\nPhongBan \&quot;0..1\&quot; ||--o{ QuyetDinhKhenThuong : \&quot;áp dụng tập thể\&quot;\nPhongBan \&quot;0..1\&quot; ||--o{ QuyetDinhKyLuat : \&quot;áp dụng tập thể\&quot;\nPhongBan \&quot;1\&quot; ||--o{ QuyetDinhTuyenDung : \&quot;tiếp nhận\&quot;\n\nChucVu \&quot;1\&quot; ||--o{ QuyetDinhChucVu : \&quot;quy định\&quot;\n\nNhanVien \&quot;1\&quot; ||--o{ QuyetDinhTuyenDung : \&quot;được tuyển\&quot;\nNhanVien \&quot;1\&quot; ||--o{ HopDong : \&quot;ký kết\&quot;\nNhanVien \&quot;1\&quot; ||--o| HoSoBaoHiem : \&quot;sở hữu\&quot;\nNhanVien \&quot;1\&quot; ||--o{ QuyetDinhLuong : \&quot;nhận\&quot;\nNhanVien \&quot;1\&quot; ||--o{ QuyetDinhChucVu : \&quot;được bổ nhiệm\&quot;\nNhanVien \&quot;1\&quot; ||--o{ BangChamCong : \&quot;được chấm công\&quot;\nNhanVien \&quot;1\&quot; ||--o{ BangLuong : \&quot;nhận lương\&quot;\nNhanVien \&quot;1\&quot; ||--o{ ChiTietPhuTroi : \&quot;tham gia\&quot;\nNhanVien \&quot;0..1\&quot; ||--o{ QuyetDinhKhenThuong : \&quot;áp dụng cá nhân\&quot;\nNhanVien \&quot;0..1\&quot; ||--o{ QuyetDinhKyLuat : \&quot;áp dụng cá nhân\&quot;\n\nPhieuPhuTroi \&quot;1\&quot; ||--|{ ChiTietPhuTroi : \&quot;chứa\&quot;\n\nQuyetDinhKhenThuong \&quot;1\&quot; ||--o| PhieuChiThuong : \&quot;phát sinh\&quot;\nQuyetDinhKyLuat \&quot;1\&quot; ||--o| PhieuThuPhat : \&quot;phát sinh\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="UalkuwrgmSluKi_TGLWN-195">
          <mxCell connectable="0" parent="ynYtLSSX9TxJPfR4FnTc-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
