        <mxCell id="z-zWjZGwvkHOLUunxK8L-0" />
        <mxCell id="z-zWjZGwvkHOLUunxK8L-1" parent="z-zWjZGwvkHOLUunxK8L-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam style strictuml\nskinparam packageStyle rectangle\n\n\n    class PhongBan {\n        + MaPB : String &lt;&lt;PK&gt;&gt;\n        + TenPB : String\n        + LoaiDonVi : String\n        + themPhongBan() : void\n    }\n\n    class ChucVu {\n        + MaCV : String &lt;&lt;PK&gt;&gt;\n        + TenCV : String\n        + themChucVu() : void\n    }\n\n    class NhanVien {\n        + MaNV : String &lt;&lt;PK&gt;&gt;\n        + HoTen : String\n        + NgaySinh : Date\n        + GioiTinh : String\n        + DienThoai : String\n        + DiaChi : String\n        + TrangThai : String\n        + themNhanVien() : void\n        + chuyenChinhThuc() : void\n    }\n\n    class QuyetDinhTuyenDung {\n        + SoQD : String &lt;&lt;PK&gt;&gt;\n        + NgayQD : Date\n        + NgayBatDauThuViec : Date\n        + NgayKetThucThuViec : Date\n        + LuongThuViec : Decimal\n        + DieuKhoan : String\n        + lapQuyetDinh() : void\n        + tinhThoiGianThuViec() : int\n    }\n\n    class HopDong {\n        + SoHD : String &lt;&lt;PK&gt;&gt;\n        + LoaiHD : String\n        + NgayKy : Date\n        + NgayBatDau : Date\n        + NgayKetThuc : Date\n        + kyHopDong() : void\n    }\n\n    class QuyetDinhLuong {\n        + SoQD : String &lt;&lt;PK&gt;&gt;\n        + NgayHieuLuc : Date\n        + LuongCoBan : Decimal\n        + PhuCapLuong : Decimal\n        + PhuCapDocHai : Decimal\n        + LyDo : String\n        + lapQuyetDinhLuong() : void\n    }\n\n    class QuyetDinhChucVu {\n        + SoQD : String &lt;&lt;PK&gt;&gt;\n        + NgayHieuLuc : Date\n        + PhuCapChucVu : Decimal\n        + boNhiem() : void\n    }\n\n    class HoSoBaoHiem {\n        + MaHS : String &lt;&lt;PK&gt;&gt;\n        + SoBHXH : String\n        + SoBHYT : String\n        + TyLeBHXH : float\n        + TyLeBHYT : float\n        + NgayLap : Date\n        + lapHoSo() : void\n        + tinhKhoanTru() : Decimal\n    }\n\n    class BangChamCong {\n        + Thang : int &lt;&lt;PK&gt;&gt;\n        + Nam : int &lt;&lt;PK&gt;&gt;\n        + NgayCongChuan : int\n        + SoNgayCong : float\n        + nhapChamCong() : void\n    }\n\n    class KeHoachTuan {\n        + MaKH : String &lt;&lt;PK&gt;&gt;\n        + TuNgay : Date\n        + DenNgay : Date\n        + NoiDungPhanCong : String\n        + GioPhuTroiDuKien : float\n        + lapKeHoach() : void\n    }\n\n    class PhieuPhuTroi {\n        + SoPhieu : String &lt;&lt;PK&gt;&gt;\n        + NgayPhuTroi : Date\n        + SoGio : float\n        + HinhThuc : String\n        + lapPhieu() : void\n        + tinhGioQuyDoi() : float\n    }\n\n    class ChiTietPhuTroi {\n        + SoPhieu : String &lt;&lt;PK&gt;&gt;\n        + MaNV : String &lt;&lt;PK&gt;&gt;\n        + themNhanVien() : void\n    }\n\n    class QuyetDinhKhenThuong {\n        + SoQD : String &lt;&lt;PK&gt;&gt;\n        + NgayQD : Date\n        + LoaiDoiTuong : String\n        + LoaiKhenThuong : String\n        + SoTien : Decimal\n        + NguoiKy : String\n        + lapQuyetDinh() : void\n    }\n\n    class PhieuChiThuong {\n        + SoPhieuChi : String &lt;&lt;PK&gt;&gt;\n        + NgayLap : Date\n        + SoTien : Decimal\n        + HinhThuc : String\n        + lapPhieuChi() : void\n    }\n\n    class QuyetDinhKyLuat {\n        + SoQD : String &lt;&lt;PK&gt;&gt;\n        + NgayQD : Date\n        + LoaiDoiTuong : String\n        + HinhThucKyLuat : String\n        + SoTienPhat : Decimal\n        + NguoiKy : String\n        + lapQuyetDinh() : void\n    }\n\n    class PhieuThuPhat {\n        + SoPhieuThu : String &lt;&lt;PK&gt;&gt;\n        + NgayLap : Date\n        + SoTien : Decimal\n        + HinhThuc : String\n        + lapPhieuThu() : void\n    }\n\n    class BangLuong {\n        + Thang : int &lt;&lt;PK&gt;&gt;\n        + Nam : int &lt;&lt;PK&gt;&gt;\n        + LuongCoBan : Decimal\n        + PhuCap : Decimal\n        + LuongNgayCong : Decimal\n        + TienPhuTroi : Decimal\n        + Thuong : Decimal\n        + KhoanTruBH : Decimal\n        + Phat : Decimal\n        + ThucLinh : Decimal\n        + tinhLuong() : Decimal\n    }\n\n\n&#39; Quan hệ giữa các lớp (Relationships &amp; Multiplicities)\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien : quản lý &gt;\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachTuan : lập &gt;\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong : nhận (tập thể) &gt;\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat : chịu (tập thể) &gt;\n\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu : quy định &gt;\n\nNhanVien \&quot;1\&quot; -- \&quot;1..*\&quot; QuyetDinhTuyenDung : áp dụng &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDong : ký &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..1\&quot; HoSoBaoHiem : sở hữu &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong : nhận &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu : được bổ nhiệm &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BangChamCong : chấm công &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BangLuong : có &gt;\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhuTroi : tham gia &gt;\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong : nhận (cá nhân) &gt;\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat : chịu (cá nhân) &gt;\n\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhuTroi : gồm &gt;\n\nQuyetDinhKhenThuong \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuChiThuong : kèm theo &gt;\nQuyetDinhKyLuat \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuThuPhat : kèm theo &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EwQyPDFG33wN14DbmGni-0">
