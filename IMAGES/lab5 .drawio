        <mxCell id="vbGOKrLrezcsj6Kh2FtI-1" parent="vbGOKrLrezcsj6Kh2FtI-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontSize 14\ntitle LAB5 - ACTIVITY: HUY PHIEU DANG KY DOAN\nstart\n:NV kinh doanh chọn phiếu đăng ký đoàn;\n:Tra cứu NgayDi và TrangThai từ DangKyDoan;\nif (Tìm thấy phiếu?) then (Có)\n  if (TrangThai = \&quot;Đã đăng ký\&quot;?) then (Có)\n    if (NgayDi &gt; ngày hiện tại?) then (Có)\n      :Mở kết nối, BeginTransaction;\n      :Xóa các phân công HDV của phiếu;\n      :Cập nhật TrangThai = \&quot;Hủy - mất cọc\&quot;;\n      if (Các lệnh SQL thành công?) then (Có)\n        :Commit transaction;\n        :Thông báo hủy thành công, mất cọc;\n        :Nạp lại danh sách phiếu;\n      else (Không)\n        :Rollback transaction;\n        :Thông báo lỗi;\n      endif\n    else (Không)\n      :Từ chối: đoàn đã khởi hành;\n    endif\n  else (Không)\n    :Từ chối: trạng thái không hợp lệ;\n  endif\nelse (Không)\n  :Từ chối: không tìm thấy phiếu;\nendif\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="hGuPQA0p1TjME_JrqdI--0">
          <mxCell connectable="0" parent="vbGOKrLrezcsj6Kh2FtI-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="start_0" plantUmlBaseStyle="ellipse;fillColor=#222222;strokeColor=#222222;shadow=0;fontSize=14;" plantUmlBaseValue="" id="hGuPQA0p1TjME_JrqdI--1">
          <mxCell parent="hGuPQA0p1TjME_JrqdI--0" style="ellipse;fillColor=#222222;strokeColor=#222222;shadow=0;fontSize=14;" vertex="1">
