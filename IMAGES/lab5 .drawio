        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontSize 14\ntitle LAB5 - ACTIVITY: TAO LICH CHUYEN KHACH LE\nstart\n:NV điều hành mở FrmChuyenLe;\n:Chọn tour, nhập mã chuyến,\\nngày đi và địa điểm đón;\nif (Thông tin bắt buộc đầy đủ?) then (Có)\n  :Tra cứu SoNgay của tour đang mở bán;\n  if (Tìm thấy tour đang mở bán?) then (Có)\n    :Tính NgayVe = NgayDi + SoNgay - 1;\n    :Ghi bản ghi ChuyenLe vào SQL Server;\n    if (Ghi CSDL thành công?) then (Có)\n      :Thông báo tạo chuyến thành công;\n      :Nạp lại danh sách chuyến;\n    else (Không)\n      :Báo lỗi SQL (ví dụ trùng MaChuyen);\n    endif\n  else (Không)\n    :Báo tour không tồn tại hoặc chưa mở bán;\n  endif\nelse (Không)\n  :Báo thông tin chuyến chưa đầy đủ;\nendif\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="NXxoOevDUUXnyPJyJj4U-0">
