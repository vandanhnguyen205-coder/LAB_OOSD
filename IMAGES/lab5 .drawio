        <mxCell id="zEJPVmJPVIM-pwN_Taa4-0" />
        <mxCell id="zEJPVmJPVIM-pwN_Taa4-1" parent="zEJPVmJPVIM-pwN_Taa4-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam defaultFontSize 14\ntitle LAB5 - SEQUENCE: HUY DANG KY DOAN (MAT COC)\nactor \&quot;NV kinh doanh\&quot; as NV\nboundary \&quot;FrmDangKyDoan\&quot; as Form\ncontrol \&quot;DangKyDoanService\&quot; as S\nparticipant \&quot;Db / SqlConnection\&quot; as Db\ndatabase \&quot;SQL Server\&quot; as SQL\nNV -&gt; Form : Chọn phiếu, nhấn \&quot;Hủy phiếu\&quot;\nForm -&gt; S : HuyDangKy(soDK)\nS -&gt; Db : Query(SELECT NgayDi, TrangThai WHERE SoDKDoan=@s)\nDb -&gt; SQL : SELECT NgayDi, TrangThai FROM DangKyDoan\nSQL --&gt; Db : Dữ liệu phiếu / rỗng\nDb --&gt; S : DataTable\nalt Không có phiếu\n  S --&gt; Form : Fail(\&quot;Không tìm thấy phiếu\&quot;)\nelse Trạng thái khác \&quot;Đã đăng ký\&quot;\n  S --&gt; Form : Fail(\&quot;Không được hủy\&quot;)\nelse Ngày đi &lt;= hôm nay\n  S --&gt; Form : Fail(\&quot;Đoàn đã khởi hành\&quot;)\nelse Hợp lệ\n  S -&gt; Db : OpenConnection(); BeginTransaction()\n  S -&gt; SQL : DELETE PhanCongHDV WHERE SoDKDoan=@s\n  S -&gt; SQL : UPDATE DangKyDoan SET TrangThai=&#39;Hủy - mất cọc&#39;\n  alt Hai lệnh thực thi thành công\n    S -&gt; Db : Commit()\n    S --&gt; Form : Ok(\&quot;Đã hủy phiếu, mất tiền cọc\&quot;)\n    Form -&gt; Form : Tai() nạp lại danh sách\n  else Xảy ra lỗi\n    S -&gt; Db : Rollback()\n    S --&gt; Form : Fail(ex.Message)\n  end\nend\nForm -&gt; Form : FormHelper.Bao(kết quả)\nForm --&gt; NV : Hiển thị kết quả\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Pbl_0RtfUW1XJ0KDBQzL-0">
          <mxCell connectable="0" parent="zEJPVmJPVIM-pwN_Taa4-1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
